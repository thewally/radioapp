<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        App Actions built-in intent for Google Assistant / Gemini voice control.
        Lets a user say "Hey Google, speel [zender] op Radio" to launch the app
        and start a station. The requested station name is resolved to a stream
        by PlaybackService (see Stations.byQuery / onAddMediaItems).
        Test locally with the App Actions Test Tool before relying on the
        unqualified "speel [zender]" phrase, which requires Play Console
        app verification.
    -->
    <capability android:name="actions.intent.PLAY_MEDIA">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.arjenvdw.radioapp"
            android:targetClass="com.arjenvdw.radioapp.MainActivity">
            <parameter
                android:name="mediaType"
                android:key="mediaType" />
        </intent>
    </capability>
</shortcuts>
